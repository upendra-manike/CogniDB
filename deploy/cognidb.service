[Unit]
Description=CogniDB AI-Native Unified Database Server (JDK 21 LTS Engine)
Documentation=https://github.com/cognidb/cognidb
After=network.target remote-fs.target syslog.target

[Service]
Type=simple
User=cognidb
Group=cognidb
EnvironmentFile=/etc/cognidb/cognidb.conf
ExecStart=/usr/bin/java -Xms2g -Xmx8g -XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -XX:+UseNUMA -XX:+UseStringDeduplication -jar /usr/share/cognidb/cognidb-engine-1.0.0-SNAPSHOT.jar
Restart=always
RestartSec=5s
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
