[Unit]
Description=SyntricDB AI-Native Unified Database Server (JDK 21 LTS Engine)
Documentation=https://github.com/syntricdb/syntricdb
After=network.target remote-fs.target syslog.target

[Service]
Type=simple
User=syntricdb
Group=syntricdb
EnvironmentFile=/etc/syntricdb/syntricdb.conf
ExecStart=/usr/bin/java -Xms2g -Xmx8g -XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch -XX:+UseNUMA -XX:+UseStringDeduplication -jar /usr/share/syntricdb/syntricdb-engine-1.0.0-SNAPSHOT.jar
Restart=always
RestartSec=5s
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
